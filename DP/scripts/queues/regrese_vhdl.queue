# Regrese VHDL po úpravách kódu (komentáře, přejmenování): všechny testbenche v xsim (bez úplných testů HSV 2^24).
cd DP/vhdl/tb && bash gen_vectors.sh
cd DP/vhdl/scripts && bash run_xsim.sh tb_axis_skid_buffer
cd DP/vhdl/scripts && for p in 0 1 2 3 4 5 6 7 8; do bash run_xsim.sh tb_csc G_PRESET=$p G_VALID_PCT=70 G_READY_PCT=70 || exit 1; done
cd DP/vhdl/scripts && for p in 0 1 6; do bash run_xsim.sh tb_csc_axil G_PRESET=$p || exit 1; done
cd DP/vhdl/scripts && for t in 0 1; do bash run_xsim.sh tb_rgb2hsv G_TEST=$t G_VALID_PCT=60 G_READY_PCT=60 && bash run_xsim.sh tb_hsv2rgb G_TEST=$t G_VALID_PCT=60 G_READY_PCT=60 || exit 1; done
cd DP/vhdl/scripts && bash run_xsim.sh tb_hsv_axil G_RGB_TO_HSV=true G_TEST=1 && bash run_xsim.sh tb_hsv_axil G_RGB_TO_HSV=false G_TEST=1 && bash run_xsim.sh tb_hsv_axil G_RGB_TO_HSV=false G_USE_DSP=true G_TEST=1
cd DP/vhdl/scripts && bash run_xsim.sh tb_threshold && bash run_xsim.sh tb_threshold G_VALID_PCT=100 G_READY_PCT=100 && bash run_xsim.sh tb_threshold_axil
cd DP/vhdl/scripts && for b in true false; do bash run_xsim.sh tb_histogram G_USE_BRAM=$b && bash run_xsim.sh tb_histogram_axil G_USE_BRAM=$b || exit 1; done
cd DP/vhdl/scripts && for size in 0 1 2 3 4 5; do for rep in true false; do bash run_xsim.sh tb_median G_SIZE=$size G_REPLICATE=$rep G_VALID_PCT=70 G_READY_PCT=70 || exit 1; done; done
cd DP/vhdl/scripts && bash run_xsim.sh tb_median G_GARBAGE=7 && bash run_xsim.sh tb_median G_BAD_EOL_ROW=5 && bash run_xsim.sh tb_median_axil G_REPLICATE=true && bash run_xsim.sh tb_median_axil G_REPLICATE=false
cd DP/vhdl/scripts && for kern in identity mean sharpen sobel_x sobel_y; do for rep in true false; do bash run_xsim.sh tb_filter2d G_KERNEL=$kern G_REPLICATE=$rep G_VALID_PCT=70 G_READY_PCT=70 || exit 1; done; done
cd DP/vhdl/scripts && for k in 5 7; do for size in "64 48" "9 3" "8 1"; do set -- $size; bash run_xsim.sh tb_filter2d G_K=$k G_KERNEL=k$k G_WIDTH=$1 G_HEIGHT=$2 G_VALID_PCT=70 G_READY_PCT=70 || exit 1; done; done
cd DP/vhdl/scripts && bash run_xsim.sh tb_filter2d_axil G_KERNEL=sobel_x && bash run_xsim.sh tb_filter2d_axil G_K=5 G_KERNEL=k5 && bash run_xsim.sh tb_filter2d_axil G_K=7 G_KERNEL=k7 G_REPLICATE=false
cd DP/vhdl/scripts && for k in 3 5 7; do bash run_xsim.sh tb_filter2d_reset G_K=$k || exit 1; done
