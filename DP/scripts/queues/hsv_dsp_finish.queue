# Dokončení fronty hsv_dsp od kroku 9 (OOC HLS varianty s DSP selhal: skript bral jméno IP místo top modulu).
# Kroky 1-8 hsv_dsp prošly (xsim, VHDL OOC, HLS csim/syn/cosim/impl obou variant).
# @stop_on_error
cd DP/hls/scripts && vivado -mode batch -nojournal -nolog -source ooc_impl_hls.tcl -tclargs ../build/hsv_hsv2rgb_dsp hls_hsv2rgb_dsp hls_hsv2rgb
cd DP/hls && python3 scripts/collect_reports.py build ~/logs/hls_results.csv
cd DP/vhdl/scripts && python3 collect_vhdl.py ../../hls/build/ooc ~/logs/hls_ooc_results.csv
