# Regrese HLS po úpravách kódu (komentáře, přejmenování): C-simulace + kosimulace všech jader proti modelu.
# Úplný test HSV 2^24 (TB_HSV_FULL=1) jen v krocích na konci, kosimulace zkrácená. Selhání = prohlédnout steps/NN.log.
cd DP/model && make -s test
cd DP/hls/scripts && for c in csc/hls_config_rgb csc/hls_config_rgb_to_gray csc/hls_config_gray_to_rgb; do bash run_hls.sh ../$c.cfg csim && bash run_hls.sh ../$c.cfg syn && bash run_hls.sh ../$c.cfg cosim || exit 1; done
cd DP/hls/scripts && for c in hsv/hls_config_rgb2hsv hsv/hls_config_hsv2rgb hsv/hls_config_hsv2rgb_dsp_lat; do bash run_hls.sh ../$c.cfg csim && bash run_hls.sh ../$c.cfg syn && bash run_hls.sh ../$c.cfg cosim || exit 1; done
cd DP/hls/scripts && for c in threshold/hls_config median/hls_config histogram/hls_config filter/hls_config_3x3 filter/hls_config_5x5 filter/hls_config_7x7; do bash run_hls.sh ../$c.cfg csim && bash run_hls.sh ../$c.cfg syn && bash run_hls.sh ../$c.cfg cosim || exit 1; done
cd DP/hls/scripts && TB_HSV_FULL=1 bash run_hls.sh ../hsv/hls_config_rgb2hsv.cfg csim && TB_HSV_FULL=1 bash run_hls.sh ../hsv/hls_config_hsv2rgb_dsp_lat.cfg csim
