# Testovací řetězec na KV260: block design (nejdřív jen BD a validace - rychlá chyba), pak syntéza +
# implementace + bitstream + XSA při 200 MHz. VHDL IP z fronty hw_ip, HLS IP z DP/hls/build/*/hls/impl/ip
# (chybějící HLS jádra BD přeskočí s varováním). Výstup: DP/hw/build/harness/{harness.xsa,harness_map.h,*.rpt}
# @stop_on_error
cd DP/hw/harness && vivado -mode batch -nojournal -nolog -source build_harness.tcl -tclargs 200 bd_only
cd DP/hw/harness && vivado -mode batch -nojournal -nolog -source build_harness.tcl -tclargs 200
