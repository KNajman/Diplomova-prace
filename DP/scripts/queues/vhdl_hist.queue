# VHDL histogram, obě architektury (G_USE_BRAM: koše v BRAM s forwardingem jako HLS / 256 čítačů ve FF):
# vektory, xsim jádra (obrazy, extrémy pro forwarding, malé rozměry, garbage), obálka s paměťovým oknem, OOC, CSV
cd DP/vhdl/tb && bash gen_vectors.sh
cd DP/vhdl/scripts && for bram in true false; do for name in gray_64x48 gray_flat_64x48 gray_repeat_64x48; do bash run_xsim.sh tb_histogram G_USE_BRAM=$bram G_NAME=$name G_VALID_PCT=70 G_READY_PCT=70 || exit 1; done; done
cd DP/vhdl/scripts && for bram in true false; do bash run_xsim.sh tb_histogram G_USE_BRAM=$bram G_NAME=gray_repeat_64x48 G_VALID_PCT=100 G_READY_PCT=100 || exit 1; done
cd DP/vhdl/scripts && for bram in true false; do bash run_xsim.sh tb_histogram G_USE_BRAM=$bram G_NAME=gray_9x3 G_WIDTH=9 G_HEIGHT=3 && bash run_xsim.sh tb_histogram G_USE_BRAM=$bram G_NAME=gray_8x1 G_WIDTH=8 G_HEIGHT=1 || exit 1; done
cd DP/vhdl/scripts && for bram in true false; do bash run_xsim.sh tb_histogram G_USE_BRAM=$bram G_GARBAGE=37 G_VALID_PCT=50 G_READY_PCT=50 || exit 1; done
cd DP/vhdl/scripts && bash run_xsim.sh tb_histogram_axil G_USE_BRAM=true && bash run_xsim.sh tb_histogram_axil G_USE_BRAM=false
# první verze (čítače, doběh pipeline před výsypem) zůstane ve výsledcích jako *_v1
cd DP/vhdl/build/ooc && for d in histogram_core histogram_axil; do if [ -d $d ] && [ ! -d ${d}_v1 ]; then mv $d ${d}_v1; fi; done
cd DP/vhdl/scripts && for bram in true false; do vivado -mode batch -nojournal -nolog -source ooc_impl.tcl -tclargs histogram_core G_USE_BRAM=$bram || exit 1; done
cd DP/vhdl/scripts && for bram in true false; do vivado -mode batch -nojournal -nolog -source ooc_impl.tcl -tclargs histogram_axil G_USE_BRAM=$bram || exit 1; done
cd DP/vhdl/scripts && python3 collect_vhdl.py ../build/ooc ~/logs/vhdl_results.csv
