# =============================================================================
#  .gitignore – Diplomová práce (Vivado 2025.2, Vitis/Vitis HLS 2025.2, LaTeX)
#  Princip: BLACKLIST – ignoruje se jen to, co je generované nebo cizí.
#  Všechno ostatní (zdroje s libovolnou příponou) se verzuje automaticky.
# =============================================================================

# ----------------------------------------------------------------------------
# Vivado – generované adresáře projektu (vše se dá znovu vytvořit z .xpr/.tcl)
# ----------------------------------------------------------------------------
*.cache/
*.gen/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.tmp/
.Xil/
xsim.dir/
NA/

# Vivado – logy, žurnály, databáze simulace
*.jou
*.log
*.str
*.backup.*
*.wdb
*.wdf
webtalk*
vivado_pid*
usage_statistics_webtalk.*

# Vivado – výstupy implementace (patří do release/přílohy, ne do historie)
*.bit
*.bin
*.ltx
*.xsa
*.pdi
*.dcp
# psu_init* se generuje z .xsa
psu_init*

# ----------------------------------------------------------------------------
# Vitis HLS (unified IDE 2025.2) – výstup komponenty je ve složce hls/
# (DP/Vitis/<komponenta>/<komponenta>/hls/...), staré solution*/ z classic HLS
# ----------------------------------------------------------------------------
# POZOR: jen výstupní adresáře HLS komponent ve Vitis workspace (<komp>/<komp>/hls/),
# NE zdrojový strom DP/hls/ (obecný vzor 'hls/' by ignoroval i ten)
/DP/Vitis/**/hls/
solution*/
.autopilot/
*.wcfg.bak

# ----------------------------------------------------------------------------
# Vitis – workspace, platforma a bare-metal aplikace
# ----------------------------------------------------------------------------
_ide/
.rigel_lopper/
.vitis/
.vitisWorkspace.json
logs/
build/
export/
# Výstupy skriptovaného HLS flow (DP/hls/build, DP/hls/ip_repo)
/DP/hls/build/
/DP/hls/ip_repo/
# Platforma se generuje z .xsa (BSP, FSBL, PMUFW) – zdroj pravdy je .xsa + skript
DP/Vitis/platform_*/
compile_commands.json

# Objektové soubory a binárky
*.o
*.d
*.a
*.so
*.elf
*.exe
*.out
*.lock

# ----------------------------------------------------------------------------
# LaTeX – pomocné soubory překladu (XeLaTeX + biber + latexmk)
# ----------------------------------------------------------------------------
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.out
*.run.xml
*.synctex.gz
*.synctex(busy)
*.toc
*.lof
*.lot
*.xdv
*.idx
*.ilg
*.ind
*.nav
*.snm
*.vrb
_minted*/
Diplomová_práce/build/
# výsledné PDF práce (generované) – zdrojové PDF (zadání, loga) zůstávají
/Diplomová_práce.pdf
/Diplomová_práce/DP.pdf

# ----------------------------------------------------------------------------
# Archivy, cizí dokumentace a velké experimenty mimo rozsah DP
# ----------------------------------------------------------------------------
*.zip
*.7z
*.tar.gz
# datasheety a manuály AMD/ITU – stáhnutelné, chráněné autorským právem
/pdf/*.pdf
# schéma nosné desky (stáhnutelné z AMD); .xdc soubory zůstávají
/Kria_KV260/xtp682-kria-k26-carrier-card-schematic/
# experimenty a cvičení mimo diplomovou práci (lokálně zůstávají)
/DP/Vivado/fractal/
/DP/Vivado/DisplayPortTest/
/DP/Vivado/dp_test/
/DP/Vivado/extracted/
/DP/Vitis/test_proj/
/DP/Vitis/test_passthought/
/DP/lab05_axi_stream/

# ----------------------------------------------------------------------------
# IDE a nástroje
# ----------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
# Sigasi / Eclipse – osobní nastavení
.settings/
.project
.library_mapping.xml

# Systém
Thumbs.db
desktop.ini
.DS_Store
